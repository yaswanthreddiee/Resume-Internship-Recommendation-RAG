# Gemini API Configuration (Optional: fallback engine is automatically engaged if omitted)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ChromaDB Configuration
CHROMA_DB_DIR=chroma_db
CHROMA_COLLECTION_NAME=internship_collection

# Embedding Model Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Hybrid Retrieval Default Weights
HYBRID_SEMANTIC_WEIGHT=0.65
HYBRID_KEYWORD_WEIGHT=0.35
